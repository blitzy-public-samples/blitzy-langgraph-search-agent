#------------------------------------------------------------------------------
# Terraform Variables Example Configuration
#
# This file provides example values for all Terraform variables used to
# provision the LangGraph Search Agent infrastructure on AWS.
#
# USAGE:
# 1. Copy this file to terraform.tfvars
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. Update the placeholder values (marked with <...>) with your actual values
#
# 3. Review and adjust other values based on your environment requirements
#
# IMPORTANT:
# - The terraform.tfvars file should NOT be committed to version control
#   as it may contain sensitive configuration values
# - All resource names must match existing CI/CD workflow expectations
# - AWS region must be us-east-1 per project requirements (Constraint C-005)
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# Project Configuration
#------------------------------------------------------------------------------

# Name of the project used for resource naming and tagging
# This name is used as a prefix for most AWS resources
# Must match existing CI/CD workflow resource naming conventions
project_name = "langgraph-search-agent"

# Deployment environment (dev, staging, or production)
# Affects resource sizing, scaling parameters, and naming
# Valid values: dev, staging, production
environment = "production"

# AWS region where all resources will be provisioned
# IMPORTANT: Must be us-east-1 per project requirements (Constraint C-005)
# Do not change this value unless project requirements are updated
aws_region = "us-east-1"

#------------------------------------------------------------------------------
# Resource Tagging Configuration
#------------------------------------------------------------------------------

# Additional tags to apply to all resources
# Common tags (Project, Environment, ManagedBy, Region) are automatically applied
# Add any organization-specific tags here
tags = {
  # Example additional tags:
  # Owner       = "platform-team"
  # CostCenter  = "engineering"
  # Application = "langgraph-search-agent"
}

#------------------------------------------------------------------------------
# ECR Configuration
#------------------------------------------------------------------------------

# Name of the ECR repository for storing backend Docker images
# MUST match the CI/CD workflow configuration in backend-deploy.yml
ecr_repository_name = "langgraph-search-agent-backend"

# Number of tagged Docker images to retain in ECR
# Older images will be automatically deleted by lifecycle policy
# Recommended: 10 for production, 5 for dev/staging
image_retention_count = 10

# Enable image vulnerability scanning on push to ECR repository
# Recommended: true for all environments
ecr_scan_on_push = true

#------------------------------------------------------------------------------
# ECS Configuration
#------------------------------------------------------------------------------

# Name of the ECS cluster for running Fargate tasks
# MUST match the CI/CD workflow configuration in backend-deploy.yml
ecs_cluster_name = "langgraph-search-agent-cluster"

# Name of the ECS service managing the Fargate tasks
# MUST match the CI/CD workflow configuration in backend-deploy.yml
ecs_service_name = "langgraph-search-agent-service"

# Name of the ECS task definition for the backend container
# MUST match the CI/CD workflow configuration in backend-deploy.yml
ecs_task_name = "langgraph-search-agent-task"

# Name of the container within the ECS task definition
# MUST match the CI/CD workflow configuration in backend-deploy.yml
container_name = "langgraph-search-agent-container"

# Port number the backend container listens on
# FastAPI application runs on port 8000 as defined in backend/Dockerfile
container_port = 8000

# Fargate CPU units for the task
# Valid values: 256, 512, 1024, 2048, 4096
# Recommended: 256 (dev), 512 (staging), 1024 (production)
cpu = 1024

# Fargate memory in MB for the task
# Must be compatible with selected CPU value per AWS Fargate requirements
# Recommended: 512 (dev), 1024 (staging), 2048 (production)
memory = 2048

# Desired number of ECS tasks to run
# This is the target count that the service will maintain
# Recommended: 1 (dev), 1 (staging), 2 (production)
desired_count = 2

# Minimum number of ECS tasks for auto-scaling
# The service will never scale below this number
# Recommended: 1 (dev), 1 (staging), 2 (production)
min_capacity = 2

# Maximum number of ECS tasks for auto-scaling
# The service will never scale above this number
# Recommended: 2 (dev), 3 (staging), 10 (production)
max_capacity = 10

# HTTP path for ALB health checks
# The FastAPI backend exposes health status at /health endpoint
health_check_path = "/health"

# Interval between health checks in seconds
health_check_interval = 30

# Health check timeout in seconds (must be less than interval)
health_check_timeout = 5

# Number of consecutive successful health checks to mark target healthy
health_check_healthy_threshold = 2

# Number of consecutive failed health checks to mark target unhealthy
health_check_unhealthy_threshold = 3

#------------------------------------------------------------------------------
# Auto-Scaling Configuration
#------------------------------------------------------------------------------

# Target CPU utilization percentage for auto-scaling
# The service scales when average CPU exceeds this threshold
# Recommended: 70 for most workloads
cpu_target_value = 70

# Cooldown period in seconds after a scale-out activity completes
# Prevents rapid scaling by requiring a wait period
# Recommended: 60 (dev/staging), 60 (production)
scale_out_cooldown = 60

# Cooldown period in seconds after a scale-in activity completes
# Longer periods help prevent flapping during variable load
# Recommended: 120 (dev/staging), 300 (production)
scale_in_cooldown = 300

#------------------------------------------------------------------------------
# Frontend Configuration
#------------------------------------------------------------------------------

# Name of the S3 bucket for hosting frontend static assets
# MUST match the CI/CD workflow configuration in frontend-deploy.yml
# S3 bucket names must be globally unique
frontend_bucket_name = "langgraph-search-agent-frontend-production"

# CloudFront price class determining which edge locations to use
# PriceClass_100: US, Canada, Europe (lowest cost)
# PriceClass_200: US, Canada, Europe, Asia, Middle East, Africa
# PriceClass_All: All edge locations (highest performance, highest cost)
cloudfront_price_class = "PriceClass_100"

# Default TTL in seconds for CloudFront cache when no Cache-Control header is set
# 86400 seconds = 24 hours
cloudfront_default_ttl = 86400

# Maximum TTL in seconds for CloudFront cache
# 31536000 seconds = 1 year
cloudfront_max_ttl = 31536000

# Minimum TTL in seconds for CloudFront cache
cloudfront_min_ttl = 0

#------------------------------------------------------------------------------
# Networking Configuration
#------------------------------------------------------------------------------

# CIDR block for the VPC
# Provides the IP address range for all VPC resources
# Default 10.0.0.0/16 provides 65,536 IP addresses
vpc_cidr = "10.0.0.0/16"

# List of availability zones for multi-AZ deployment
# Must have at least 2 AZs for high availability
# IMPORTANT: Must be in us-east-1 region
availability_zones = ["us-east-1a", "us-east-1b"]

# CIDR blocks for public subnets
# Must be within the VPC CIDR range
# One subnet per availability zone
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]

# CIDR blocks for private subnets
# Must be within the VPC CIDR range
# One subnet per availability zone
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# Enable NAT Gateway for private subnet internet access
# Required for ECS tasks to pull images and access external APIs
# IMPORTANT: Set to true for ECS Fargate to function properly
enable_nat_gateway = true

# Use a single NAT Gateway for all availability zones
# true: Cost-effective for non-production environments
# false: Multi-AZ NAT Gateways for production high availability
# Recommended: true (dev/staging), false (production)
single_nat_gateway = false

#------------------------------------------------------------------------------
# GitHub OIDC Configuration
#------------------------------------------------------------------------------

# GitHub organization or username owning the repository
# Used to configure OIDC trust relationship for secure CI/CD authentication
# PLACEHOLDER: Replace with your actual GitHub organization
github_org = "<your-github-org>"

# GitHub repository name
# Used to configure OIDC trust relationship for CI/CD authentication
# PLACEHOLDER: Replace with your actual repository name
github_repo = "<your-repo-name>"

# GitHub Actions OIDC provider thumbprint
# Default is the current GitHub thumbprint (as of 2024)
# Only change if GitHub updates their OIDC certificate
github_oidc_thumbprint = "6938fd4d98bab03faadb97b34396831e3780aea1"

#------------------------------------------------------------------------------
# Database Configuration
#------------------------------------------------------------------------------

# Name of the DynamoDB table for storing conversation sessions
# MUST match the backend application configuration in backend/app/config.py
# Table is provisioned but not actively used (future-ready)
dynamodb_table_name = "langgraph-conversations"

# DynamoDB billing mode
# PAY_PER_REQUEST: On-demand scaling without capacity planning (recommended)
# PROVISIONED: Fixed capacity with provisioned throughput
dynamodb_billing_mode = "PAY_PER_REQUEST"

# Enable TTL (Time to Live) for automatic expiration of old sessions
# Recommended: true to automatically clean up old conversation data
dynamodb_ttl_enabled = true

# Name of the TTL attribute for DynamoDB
# Items with expired TTL values are automatically deleted
dynamodb_ttl_attribute = "expiration"

#------------------------------------------------------------------------------
# Application Configuration
#------------------------------------------------------------------------------

# List of allowed CORS origins for the backend API
# Use ["*"] to allow all origins (acceptable for development)
# For production, specify exact frontend domain(s)
cors_origins = ["*"]

# Base URL for the backend API
# Used by the frontend application to make API calls
# Will be set to ALB DNS name if left empty
# Example: "https://api.example.com" or "http://alb-dns-name.region.elb.amazonaws.com"
api_url = ""

#------------------------------------------------------------------------------
# Monitoring Configuration
#------------------------------------------------------------------------------

# Number of days to retain CloudWatch logs
# Longer retention increases storage costs
# Valid values: 0, 1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, etc.
# Recommended: 7 (dev), 14 (staging), 30 (production)
log_retention_days = 30

# Enable CloudWatch Container Insights for detailed ECS monitoring
# Provides additional metrics like CPU, memory, network usage per container
# Recommended: false (dev), true (staging/production)
enable_container_insights = true

# Enable ECS Exec for debugging containers
# Allows running commands in containers via AWS CLI
# Security consideration: Set to false in production unless debugging is needed
enable_execute_command = false

#------------------------------------------------------------------------------
# Secrets Configuration
#------------------------------------------------------------------------------

# Create Secrets Manager secrets for API keys
# Set to false if secrets already exist and are managed externally
create_secrets = true

# Name of the Secrets Manager secret containing the OpenAI API key
# The secret value must be set manually after infrastructure creation
# or via a separate secure process
openai_api_key_secret_name = "langgraph-search-agent/openai-api-key"

# Name of the Secrets Manager secret containing the Tavily API key
# The secret value must be set manually after infrastructure creation
# or via a separate secure process
tavily_api_key_secret_name = "langgraph-search-agent/tavily-api-key"

#------------------------------------------------------------------------------
# Terraform State Backend Configuration
#------------------------------------------------------------------------------

# S3 bucket name for storing Terraform state files
# Must be globally unique across all AWS accounts
# Note: This bucket should be created before using remote state backend
terraform_state_bucket = "langgraph-search-agent-terraform-state"

# DynamoDB table name for Terraform state locking
# Provides locking to prevent concurrent state modifications
terraform_state_lock_table = "langgraph-search-agent-terraform-locks"

# S3 key path for the Terraform state file
# Use environment-specific paths for isolated state per environment
# Example: "state/dev/terraform.tfstate", "state/prod/terraform.tfstate"
terraform_state_key = "state/terraform.tfstate"

#------------------------------------------------------------------------------
# ALB Configuration
#------------------------------------------------------------------------------

# Set to true to create an internal ALB
# Internal ALBs are not accessible from the internet
# Recommended: true (internal applications), false (public-facing)
alb_internal = false

# Time in seconds that the connection is allowed to be idle
# Increase for long-running requests or WebSocket connections
alb_idle_timeout = 60

# Enable deletion protection for the ALB
# Prevents accidental deletion via Terraform
# Recommended: false (dev/staging), true (production)
alb_deletion_protection = false

# Enable HTTPS on the ALB
# Requires a valid ACM certificate
# Recommended: false (dev), true (staging/production with custom domain)
enable_https = false

# ARN of the ACM certificate for HTTPS
# Required if enable_https is true
# Example: "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"
acm_certificate_arn = ""

# SSL policy for the HTTPS listener
# Only used if enable_https is true
# Recommended: "ELBSecurityPolicy-TLS13-1-2-2021-06" (latest secure policy)
ssl_policy = "ELBSecurityPolicy-TLS13-1-2-2021-06"
